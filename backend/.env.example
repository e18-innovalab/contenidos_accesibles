# Configuración del proyecto
PROJECT_NAME="InnovaLab - Asistente de Accesibilidad"
API_V1_STR=/api/v1

# --- Conexión de IA principal (Groq, obtené la key en https://console.groq.com/keys) ---
# En cada arranque se crea/actualiza esta conexión con la prioridad más alta.
# Editarla o borrarla desde /admin no persiste. Las conexiones de respaldo se
# gestionan desde /admin. Solo AI_API_KEY es obligatoria; el resto tiene default.
AI_API_KEY=
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-120b
# AI_CONNECTION_LABEL="IL-1 gpt-oss-120b - PROD"

# --- Panel de Administración (/admin, protegido con HTTP Basic Auth) ---
ADMIN_USERNAME=admin
# Obligatoria: sin ella la app no arranca. Usá una contraseña fuerte y propia.
ADMIN_PASSWORD=

# --- Entorno: development | staging | production ---
# En development /docs, /redoc y openapi.json quedan abiertos. En staging/production
# exigen HTTP Basic Auth con DOCS_USERNAME / DOCS_PASSWORD.
ENVIRONMENT=development

# --- Documentación (Swagger/ReDoc) protegida fuera de development ---
# Credenciales propias, distintas de las de /admin. DOCS_PASSWORD es obligatoria
# en staging/production (la app no arranca sin ella).
DOCS_USERNAME=docs
DOCS_PASSWORD=

# --- Base de datos local (SQLite) de API Keys y contadores de uso ---
# En Railway debe apuntar al Volume montado (ej. /data/app_data.db); si no,
# la DB se pierde en cada deploy.
DATABASE_PATH=app_data.db

# Clave simétrica (Fernet) para cifrar las API keys guardadas en la DB.
# Generarla con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# --- Rate limit de los endpoints que consumen IA real (?mock=true no cuenta) ---
# Ventanas deslizantes de 1 minuto y 24 horas, por IP y globales. 0 desactiva ese límite.
# AI_RATE_LIMIT_PER_IP_MINUTE=5
# AI_RATE_LIMIT_PER_IP_DAY=50
# AI_RATE_LIMIT_GLOBAL_MINUTE=20
# AI_RATE_LIMIT_GLOBAL_DAY=500

# --- Web de pruebas (web/, Static Site en Render) ---
# URL pública de la web de pruebas: su origen se suma a CORS y /admin muestra el enlace.
# TEST_WEB_URL=https://innovalab-web-pruebas.onrender.com
